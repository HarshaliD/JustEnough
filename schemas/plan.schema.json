{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MinimizationPlan",
  "type": "object",
  "required": ["case_id", "decisions", "unsure", "task_output_schema"],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["action", "reason", "confidence"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["KEEP", "DROP", "MASK_PARTIAL", "GENERALIZE", "PSEUDONYMIZE", "AGGREGATE"]
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    },
    "unsure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_output_schema": {
      "type": "object"
    }
  }
}
